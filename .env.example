NODE_ENV=development
HOST=0.0.0.0
PORT=3006
PLUGIN_ID=webgl-preview

# Production container only: exact credential-free HTTPS platform origin used
# by the fixed /platform-api/v1/verses alias. No path, query or credentials.
HOST_API_BASE=https://d.dev.xrugc.com

# Production container only: compact JSON array of every exact parent Host
# origin captured in the deployment inventory. Include hxgx, voxel and brand
# origins only after they are observed; wildcards, paths and HTTP are rejected.
REQUIRE_TRUSTED_HOST_ORIGINS=1
WEBGL_PREVIEW_TRUSTED_HOST_ORIGINS_JSON=["https://d.dev.xrugc.com"]
WEBGL_PREVIEW_D_TRUSTED_HOST_ORIGINS_JSON=["https://d.dev.xrugc.com"]

# Browser-visible deployment root. Use /webgl-preview/ to emulate the
# Traefik strip-prefix registration used by the main platform.
BASE_PATH=/

# Standalone development only. The dev server maps this base behind the same
# fixed /platform-api alias. Embedded production keeps the INIT Token in memory.
PLATFORM_API_BASE=http://127.0.0.1:8081
PLATFORM_API_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
TRUSTED_HOST_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
ASSET_ORIGINS=https://data.7dgame.com,https://7dgame-public-1251022382.cos.ap-nanjing.myqcloud.com
ALLOW_MANUAL_SCENE_ID=true
ALLOW_DEVELOPMENT_TOKEN=false
REQUEST_TIMEOUT_MS=15000
MAX_DEVICE_PIXEL_RATIO=2

# Docker artifact source. Publishing requires an immutable name@sha256 digest.
WEBGL_PREVIEW_BASE_IMAGE=hkccr.ccs.tencentyun.com/plugins/webgl-preview@sha256:1e03190d0b44ca204869461862859198a801edb3b4c1bf00e8ee5e8da1d9bfe5
REQUIRE_PINNED_BASE_IMAGE=1
REQUIRE_APPROVED_BUILD=1
